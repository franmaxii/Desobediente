---
import { Font } from 'astro:assets';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Reacciones from '../components/Reacciones.astro';
import { artista } from '../data/artista';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** Datos estructurados (JSON-LD) de la página. */
  jsonLd?: object;
  /** Para páginas que no deben aparecer en Google (ej. 404). */
  noindex?: boolean;
  /** Muestra el botón flotante de corazones. */
  reacciones?: boolean;
}

const {
  title = artista.titulo,
  description = artista.descripcion,
  jsonLd,
  noindex = false,
  reacciones = true,
} = Astro.props;

const sitio = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, sitio).href;
const ogImage = new URL('/og.jpg', sitio).href;
const ogAlt = `${artista.nombre} en la portada del videoclip de «Tik Tak».`;
const esInicio = Astro.url.pathname === '/';
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="author" content={`${artista.nombreReal} (${artista.nombre})`} />
    <meta name="robots" content={noindex ? 'noindex, follow' : 'index, follow, max-image-preview:large'} />
    {!noindex && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#08080a" />

    <!-- vista previa al compartir -->
    <meta property="og:type" content="music.musician" />
    <meta property="og:site_name" content={artista.nombre} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="675" />
    <meta property="og:image:alt" content={ogAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogAlt} />

    <!-- íconos (Google pide múltiplos de 48 px) -->
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" type="image/png" href="/favicon-96.png" sizes="96x96" />
    <link rel="icon" type="image/png" href="/favicon-192.png" sizes="192x192" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <script is:inline>document.documentElement.classList.add('js');</script>

    <Font cssVariable="--font-gothic" preload />
    <Font cssVariable="--font-title" />
    <Font cssVariable="--font-cond" />
    <Font cssVariable="--font-body" />
    <Font cssVariable="--font-mono" />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href={esInicio ? '#musica' : '#contenido'}>Saltar al contenido</a>
    <Nav />
    <main id="top">
      <slot />
    </main>
    <Footer />
    {reacciones && <Reacciones />}
  </body>
</html>

<script>
  // Aparición suave de bloques al scrollear (solo los que arrancan fuera de pantalla).
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (!reduceMotion && 'IntersectionObserver' in window) {
    const targets = Array.from(document.querySelectorAll<HTMLElement>('[data-reveal]')).filter(
      (el) => el.getBoundingClientRect().top > window.innerHeight,
    );

    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-in');
          observer.unobserve(entry.target);
        }
      },
      { rootMargin: '0px 0px -8% 0px' },
    );

    for (const el of targets) {
      el.classList.add('reveal');
      const delay = Number(el.dataset.reveal);
      if (delay) el.style.transitionDelay = `${delay}ms`;
      observer.observe(el);
    }
  }
</script>
