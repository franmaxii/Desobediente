---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import Release from '../components/Release.astro';
import EP from '../components/EP.astro';
import Videoclips from '../components/Videoclips.astro';
import Galeria from '../components/Galeria.astro';
import Actriz from '../components/Actriz.astro';
import Book from '../components/Book.astro';
import Bio from '../components/Bio.astro';
import Links from '../components/Links.astro';
import { fotosEnVivo, fotosModelo, galerias } from '../data/galerias';
import { redPorId } from '../data/artista';
import { datosEstructurados } from '../utils/seo';

const jsonLd = datosEstructurados(Astro.site ?? new URL(Astro.url.origin));
const instagram = redPorId('instagram').url;
const enVivo = galerias['en-vivo'];
const modelo = galerias.modelo;
---

<Layout jsonLd={jsonLd}>
  <Hero />
  <Release />
  <EP />
  <Videoclips />
  <Galeria
    id="en-vivo"
    eyebrow={enVivo.eyebrow}
    title={enVivo.titulo}
    fotos={fotosEnVivo}
    cta={{ href: instagram, label: enVivo.cta }}
  />
  <Actriz />
  <Book />
  <Galeria
    id="modelo"
    eyebrow={modelo.eyebrow}
    title={modelo.titulo}
    fotos={fotosModelo}
    cta={{ href: instagram, label: modelo.cta }}
  />
  <Bio />
  <Links />
</Layout>
