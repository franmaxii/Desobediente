---
/**
 * Fachada liviana de YouTube: muestra la miniatura y carga el iframe
 * recién cuando se hace clic. Usa youtube-nocookie.
 */
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

interface Props {
  id: string;
  title: string;
  thumbnail: ImageMetadata;
  widths: number[];
  sizes: string;
}

const { id, title, thumbnail, widths, sizes } = Astro.props;
---

<button class="yt" type="button" data-yt={id} data-yt-title={title} aria-label={`Reproducir el videoclip de «${title}»`}>
  <Image src={thumbnail} alt="" widths={widths} sizes={sizes} />
  <span class="yt-play" aria-hidden="true"></span>
</button>

<style>
  .yt {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    padding: 0;
    border: 0;
    background: #000;
    overflow: hidden;
    cursor: pointer;
  }
  .yt :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(.9) brightness(.88);
    transition: transform .6s var(--ease), filter .4s;
  }
  .yt:hover :global(img),
  .yt:focus-visible :global(img) {
    transform: scale(1.04);
    filter: saturate(1) brightness(1);
  }

  .yt-play {
    position: absolute;
    left: 50%;
    top: 50%;
    width: 64px;
    height: 64px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: rgba(8, 8, 10, .6);
    border: 1.5px solid rgba(255, 255, 255, .85);
    -webkit-backdrop-filter: blur(4px);
    backdrop-filter: blur(4px);
    transition: background-color .25s, border-color .25s, transform .25s var(--ease);
  }
  .yt-play::before {
    content: "";
    position: absolute;
    left: 50%;
    top: 50%;
    width: 18px;
    height: 20px;
    transform: translate(-38%, -50%);
    background: #fff;
    clip-path: polygon(0 0, 100% 50%, 0 100%);
  }
  .yt:hover .yt-play,
  .yt:focus-visible .yt-play {
    background: var(--red);
    border-color: var(--red);
    transform: translate(-50%, -50%) scale(1.08);
  }

  /* el contenedor del iframe lo crea el script, por eso es global */
  :global(.yt-frame) {
    position: relative;
    aspect-ratio: 16 / 9;
    background: #000;
  }
  :global(.yt-frame iframe) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .yt :global(img) { transition: none; }
  }
</style>

<script>
  // Un solo video a la vez: al abrir otro, el anterior vuelve a su miniatura.
  let active: { frame: HTMLElement; button: HTMLButtonElement } | null = null;

  const restore = () => {
    if (!active) return;
    active.frame.replaceWith(active.button);
    active = null;
  };

  document.querySelectorAll<HTMLButtonElement>('[data-yt]').forEach((button) => {
    button.addEventListener('click', () => {
      restore();
      document.dispatchEvent(new CustomEvent('video:play'));

      const id = button.dataset.yt!;
      const frame = document.createElement('div');
      frame.className = 'yt-frame';

      const iframe = document.createElement('iframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(id)}?autoplay=1&rel=0&playsinline=1`;
      iframe.title = `Videoclip de «${button.dataset.ytTitle ?? ''}»`;
      iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share';
      iframe.allowFullscreen = true;
      iframe.referrerPolicy = 'strict-origin-when-cross-origin';

      frame.appendChild(iframe);
      button.replaceWith(frame);
      iframe.focus();
      active = { frame, button };
    });
  });
</script>
