---
/** Íconos inline. Todos heredan el color con currentColor. */
type IconName =
  | 'play'
  | 'pause'
  | 'arrow'
  | 'close'
  | 'prev'
  | 'next'
  | 'spotify'
  | 'youtube'
  | 'instagram'
  | 'tiktok'
  | 'twitch'
  | 'wattpad';

interface Props {
  name: IconName;
  class?: string;
}

const { name, class: className } = Astro.props;
---

<svg viewBox="0 0 24 24" aria-hidden="true" class:list={[`icon-${name}`, className]}>
  {name === 'play' && <path d="M7 4.5v15l13-7.5z" fill="currentColor" />}
  {name === 'pause' && <path d="M6 4h4.5v16H6zM13.5 4H18v16h-4.5z" fill="currentColor" />}
  {name === 'arrow' && <path d="M7 17 17 7M9 7h8v8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />}
  {name === 'close' && <path d="M6 6l12 12M18 6 6 18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" />}
  {name === 'prev' && <path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />}
  {name === 'next' && <path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />}
  {name === 'spotify' && (
    <>
      <circle cx="12" cy="12" r="10" fill="currentColor" />
      <path d="M6.6 9.3c3.6-1.1 7.6-.8 10.9 1" fill="none" stroke="#08080a" stroke-width="1.7" stroke-linecap="round" />
      <path d="M7.2 12.5c3-.8 6.1-.5 8.8.9" fill="none" stroke="#08080a" stroke-width="1.5" stroke-linecap="round" />
      <path d="M7.8 15.5c2.3-.6 4.6-.4 6.6.7" fill="none" stroke="#08080a" stroke-width="1.3" stroke-linecap="round" />
    </>
  )}
  {name === 'tiktok' && (
    <path
      fill="currentColor"
      d="M16.6 3c.4 2.3 1.9 3.9 4.4 4.1v3.1c-1.6 0-3.1-.5-4.4-1.3v6.4c0 3.4-2.7 5.7-5.8 5.7S5 18.7 5 15.5s2.6-5.8 6.1-5.6v3.2c-1.6-.3-3 .8-3 2.4 0 1.4 1.1 2.5 2.6 2.5 1.6 0 2.7-1.1 2.7-3V3h3.2Z"
    />
  )}
  {name === 'twitch' && (
    <path
      fill="currentColor"
      fill-rule="evenodd"
      d="M4.5 3 3 6.8V19h4.2v2.4h2.4L12 19h3.4L21 13.4V3H4.5Zm14.6 9.5-2.6 2.6h-4.2l-2.3 2.3v-2.3H6.5V4.9h12.6v7.6ZM15.6 7.6v4.6h-1.9V7.6h1.9Zm-5.1 0v4.6H8.6V7.6h1.9Z"
    />
  )}
  {name === 'youtube' && (
    <path
      fill="currentColor"
      d="M21.6 7.2a2.5 2.5 0 0 0-1.8-1.8C18.2 5 12 5 12 5s-6.2 0-7.8.4A2.5 2.5 0 0 0 2.4 7.2 26 26 0 0 0 2 12a26 26 0 0 0 .4 4.8 2.5 2.5 0 0 0 1.8 1.8c1.6.4 7.8.4 7.8.4s6.2 0 7.8-.4a2.5 2.5 0 0 0 1.8-1.8A26 26 0 0 0 22 12a26 26 0 0 0-.4-4.8ZM10 15.1V8.9l5.2 3.1Z"
    />
  )}
  {name === 'instagram' && (
    <>
      <rect x="3" y="3" width="18" height="18" rx="5" fill="none" stroke="currentColor" stroke-width="2" />
      <circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="2" />
      <circle cx="17.4" cy="6.6" r="1.3" fill="currentColor" />
    </>
  )}
  {name === 'wattpad' && (
    <path
      fill="currentColor"
      d="M3 6.5c0-1 1.4-1.4 2-.5l2.6 7.6L10.4 6c.4-1 1.8-1 2.2 0l2.6 7.6L18 6c.5-1 2-.6 2 .5 0 .2 0 .3-.1.5l-4 11c-.4 1-1.9 1-2.3 0L11.5 12l-2.1 6c-.4 1-1.9 1-2.3 0l-4-11C3 6.8 3 6.7 3 6.5Z"
    />
  )}
</svg>
