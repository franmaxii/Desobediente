---
/**
 * La mecha: soga trenzada que se quema según la variable CSS --p (0 a 1).
 * - hero: se quema sola en loop
 * - player: la quema el audio; el <input> de búsqueda va en el slot
 * - divider: soga entera, sin chispa
 */
interface Props {
  variant: 'hero' | 'player' | 'divider';
}

const { variant } = Astro.props;
const decorative = variant !== 'player';
---

<div class={`fuse fuse--${variant}`} aria-hidden={decorative ? 'true' : undefined} data-fuse={variant}>
  <span class="fuse-rope"></span>
  {variant !== 'divider' && <span class="fuse-spark"></span>}
  <slot />
</div>
