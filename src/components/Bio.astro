---
import SectionHead from './SectionHead.astro';
import { artista, bio } from '../data/artista';
import { conEnlaces } from '../lib/texto';

const [primero, ...resto] = bio.parrafos;
---

<section id="bio" class="section" aria-labelledby="bio-title">
  <SectionHead id="bio-title" eyebrow="Bio" title={bio.titulo} />

  <div class="bio-grid">
    <div class="bio-text inline-links" data-reveal>
      <p class="lead" set:html={conEnlaces(primero)} />
      {resto.map((p) => <p set:html={conEnlaces(p)} />)}

      <figure class="sueno">
        <blockquote><p>«{artista.sueno}»</p></blockquote>
        <figcaption>— Milena</figcaption>
      </figure>
    </div>

    {
      bio.ficha.length > 0 && (
        <dl class="ficha" aria-label="Ficha" data-reveal>
          {bio.ficha.map((f) => (
            <div>
              <dt>{f.etiqueta}</dt>
              <dd>{f.valor}</dd>
            </div>
          ))}
        </dl>
      )
    }
  </div>
</section>

<style>
  .bio-grid {
    display: grid;
    gap: 44px;
  }
  @media (min-width: 880px) {
    .bio-grid { grid-template-columns: minmax(0, 1.2fr) minmax(0, .8fr); gap: 72px; align-items: start; }
  }
  .bio-text p:not(.lead) { color: var(--muted); max-width: 62ch; }

  .sueno {
    margin: 36px 0 0;
    padding: 4px 0 4px 22px;
    border-left: 2px solid var(--red);
  }
  .sueno blockquote { margin: 0; }
  .bio-text .sueno blockquote p {
    margin: 0 0 10px;
    font-family: var(--f-title);
    font-weight: 900;
    font-size: clamp(1.6rem, 3.2vw, 2.2rem);
    line-height: 1.15;
    color: var(--red);
    max-width: none;
    text-wrap: balance;
  }
  .sueno figcaption {
    font-family: var(--f-mono);
    font-size: .78rem;
    letter-spacing: .08em;
    color: var(--muted);
  }

  .ficha {
    position: relative;
    margin: 0;
    padding: 26px 24px 8px;
    border: 1px dashed var(--ash);
    font-family: var(--f-mono);
    font-size: .92rem;
  }
  .ficha::before {
    content: "FICHA · Nº 13";
    position: absolute;
    top: -10px;
    left: 18px;
    padding: 0 8px;
    background: var(--bg);
    font-size: .72rem;
    letter-spacing: .14em;
    color: var(--red-text);
  }
  .ficha div {
    display: grid;
    grid-template-columns: 92px minmax(0, 1fr);
    gap: 12px;
    padding: 12px 0;
    border-bottom: 1px dashed var(--line);
  }
  .ficha div:last-child { border-bottom: 0; }
  .ficha dt {
    padding-top: 2px;
    font-size: .72rem;
    letter-spacing: .12em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .ficha dd { margin: 0; color: var(--bone); line-height: 1.5; }
</style>
