# Cloudflare Pages: headers para los archivos estáticos.

# La copia en *.pages.dev no debe competir en Google con el dominio oficial.
https://:project.pages.dev/*
  X-Robots-Tag: noindex

https://:version.:project.pages.dev/*
  X-Robots-Tag: noindex

# Los archivos de /_astro llevan un hash en el nombre: se pueden cachear para siempre.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# El panel: nunca en Google, nunca en caché, y no se puede meter dentro de otra página.
/admin/*
  X-Robots-Tag: noindex, nofollow
  Cache-Control: no-store
  X-Frame-Options: DENY
  Referrer-Policy: no-referrer

# El panel consulta esto para saber cuándo un cambio ya está online.
/version.json
  Cache-Control: no-store
